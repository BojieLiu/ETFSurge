#!/bin/sh
#
# pre-commit — 检测将要提交的代码中是否包含明文 API Key / token / secret
# 如果发现疑似泄露，阻止本次 commit。
# 跳过检测: SKIP_SECRET_CHECK=1 git commit ...
#
# 如果 frontend/ 下有文件变更，自动运行 npm run build 拦截 Vue 编译错误。
# 跳过构建: SKIP_FRONTEND_BUILD=1 git commit ...

set -e

# ── 前置检查：检测明文 API Key / token / secret ──────────────────────────
if [ "${SKIP_SECRET_CHECK}" = "1" ]; then
    echo "[pre-commit] SKIP_SECRET_CHECK=1, 跳过密钥泄露检测"
else
    # 收集暂存的文件（增/改/重命名）
    STAGED=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' '*.md' '*.json' '*.yml' '*.yaml' '*.txt' '*.cfg' '*.ini' '*.conf' 'Dockerfile' 2>/dev/null || true)

    if [ -n "$STAGED" ]; then
        HAS_LEAK=0

        check_file() {
            file="$1"
            # 跳过已知安全的文件
            case "$file" in
                .env|backend/.env|.env.example|backend/.env.example|.gitignore|*.sample)
                    return
                    ;;
                *.md)
                    case "$file" in
                        README.md|README_EN.md|AGENTS.md|GITHUB_DESCRIPTION.md|api-contracts/*)
                            return
                            ;;
                    esac
                    ;;
            esac

            [ -f "$file" ] || return

            PATTERN1='sk-[a-zA-Z0-9]\{20,\}'
            PATTERN2='[Aa][Pp][Ii]_[Kk][Ee][Yy]\s*[=:]\s*['\''"][a-zA-Z0-9_\-]\{16,\}['\''"]'
            PATTERN3='[Tt][Oo][Kk][Ee][Nn]\s*[=:]\s*['\''"][a-zA-Z0-9_\-]\{16,\}['\''"]'
            PATTERN4='[Ss][Ee][Cc][Rr][Ee][Tt]\s*[=:]\s*['\''"][a-zA-Z0-9_\-]\{16,\}['\''"]'
            PATTERN5='[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\s*[=:]\s*['\''"][a-zA-Z0-9_\-]\{16,\}['\''"]'

            for pat in "$PATTERN1" "$PATTERN2" "$PATTERN3" "$PATTERN4" "$PATTERN5"; do
                MATCHES=$(grep -Hin "$pat" "$file" 2>/dev/null || true)
                if [ -n "$MATCHES" ]; then
                    CLEAN=1
                    echo "$MATCHES" | while IFS= read -r line; do
                        case "$line" in
                            *sk-xxx*|*sk-xxxxxxxx*|*your_*|*YOUR_*|*_here*|*REDACTED*|*placeholder*)
                                continue
                                ;;
                        esac
                        echo "! [secret-leak] $file: <redacted>"
                        CLEAN=0
                    done
                    if [ "$CLEAN" -eq 0 ]; then
                        HAS_LEAK=1
                    fi
                fi
            done
        }

        for FILE in $STAGED; do
            check_file "$FILE"
        done

        if [ "$HAS_LEAK" -ne 0 ]; then
            echo ""
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            echo "!  检测到疑似 API Key / Token / Secret 明文泄露              !"
            echo "!  请移除上述文件中的敏感信息后重试 commit。                    !"
            echo "!  如需强制提交: SKIP_SECRET_CHECK=1 git commit ...           !"
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            exit 1
        fi
    fi
fi

# ── 契约-路由一致性门禁（P3-5，2026-08-09） ─────────────────────
# check_routes.py 扫描 api-contracts/*.md 与 8 个业务 router，断言两端一致。
# 放在 docs 短路之前：契约变更（api-contracts/*）必须触发，不得被纯文档短路跳过。
ROUTES_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
    -- 'api-contracts/*' 'backend/app/routers/*.py' 2>/dev/null || true)
if [ -n "$ROUTES_STAGED" ]; then
    echo "[pre-commit] 检测到契约/路由变更，执行 check_routes 一致性检查 ..."
    cd backend
    if python scripts/check_routes.py > /dev/null 2>&1; then
        echo "[pre-commit] ✅ check_routes 通过（83 路由全一致）"; cd ..
    else
        cd ..; echo "🚨 check_routes 失败 — 契约与路由不一致（见 python scripts/check_routes.py）"; exit 1
    fi
fi

# ── 纯文档/元数据短路（P4-new，2026-08-09） ──────────────────────
# docs/（含 archived/）、api-contracts/ 为文档/契约，diag/ 为诊断产物——均不改变运行代码，
# 跳过全部编译/测试门禁。注：diag/ 下是诊断脚本与产物（非运行代码），归类为"非逻辑"。
# secret 扫描在上一段已执行（文档也可能泄漏 key），故短路的仅跳过 L82 及以后。
# ⚠️ 收益说明：基线 backend/* 本来就不匹配 docs/（纯 docs 提交不触发 pytest），本段价值是
#    ① 显式语义化（无歧义）；② 防未来在 docs/ 下新增 backend 同名目录导致的意外全量回归。
DOCS_ONLY_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- \
    'docs/*' 'diag/*' 'api-contracts/*' 2>/dev/null || true)
NON_DOCS_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- \
    ':!docs/*' ':!diag/*' ':!api-contracts/*' 2>/dev/null || true)
if [ -n "$DOCS_ONLY_STAGED" ] && [ -z "$NON_DOCS_STAGED" ]; then
    echo "[pre-commit] 纯文档/元数据提交（docs/diag/api-contracts），跳过编译与测试门禁（secret 已检查）"
    exit 0
fi

# ── 前端构建检查 ──────────────────────────────────────────────────────
if [ "${SKIP_FRONTEND_BUILD}" = "1" ]; then
    echo "[pre-commit] SKIP_FRONTEND_BUILD=1, 跳过前端构建检查"
else
    FRONTEND_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'frontend/src/*' 'frontend/index.html' 'frontend/vite.config.js' 'frontend/package.json' 2>/dev/null || true)

    if [ -n "$FRONTEND_STAGED" ]; then
        echo "[pre-commit] 检测到前端源码变更，正在执行 npm run build ..."
        cd frontend
        # 在 Windows (Git Bash) 中必须通过 cmd /c 执行 npm
        if cmd /c "npm run build" 2>&1; then
            echo "[pre-commit] ✅ npm run build 通过"
            cd ..
        else
            BUILD_EXIT=$?
            cd ..
            echo ""
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            echo "!  🚫 npm run build 失败 — 前端编译错误                        !"
            echo "!  请修复上述错误后重新尝试 commit。                            !"
            echo "!  如需跳过: SKIP_FRONTEND_BUILD=1 git commit ...             !"
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            exit $BUILD_EXIT
        fi
    fi
fi

# ── API 调用覆盖检查 ────────────────────────────────────────────
if [ "${SKIP_API_CHECK}" = "1" ]; then
    echo "[pre-commit] SKIP_API_CHECK=1, 跳过 API 调用覆盖检查"
else
    FRONTEND_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/src/api/*' 2>/dev/null || true)
    if [ -n "$FRONTEND_STAGED" ]; then
        echo "[pre-commit] 检测到 API 文件变更，正在执行 check_api_usage.py ..."
        cd backend
        if python scripts/check_api_usage.py 2>&1; then
            echo "[pre-commit] ✅ API 调用覆盖检查通过"
            cd ..
        else
            cd ..
            echo ""
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            echo "!  🚫 check_api_usage 失败 — 存在定义了但未调用的 API 方法    !"
            echo "!  请检查上述未调用的方法是否需要保留或添加调用点。             !"
            echo "!  如需跳过: SKIP_API_CHECK=1 git commit ...                  !"
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            exit 1
        fi
    fi
fi

# ── 后端异步阻塞审计 ────────────────────────────────────────────
if [ "${SKIP_AUDIT_ASYNC}" = "1" ]; then
    echo "[pre-commit] SKIP_AUDIT_ASYNC=1, 跳过异步阻塞审计"
else
    BACKEND_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/app/*.py' 2>/dev/null || true)
    if [ -n "$BACKEND_STAGED" ]; then
        echo "[pre-commit] 检测到后端 Python 变更，正在执行 audit_async_blocking.py ..."
        cd backend
        if python scripts/audit_async_blocking.py 2>&1; then
            echo "[pre-commit] ✅ audit_async_blocking 通过"
            cd ..
        else
            cd ..
            echo ""
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            echo "!  🚫 audit_async_blocking 失败                                !"
            echo "!  存在 async def 内同步阻塞调用或线程池使用不当               !"
            echo "!  请修复后重试，或 SKIP_AUDIT_ASYNC=1 git commit ...          !"
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            exit 1
        fi
    fi
fi

# ── 后端类型检查（mypy） ─────────────────────────────────────────
if command -v mypy &> /dev/null; then
    if [ "${SKIP_MYPY}" = "1" ]; then
        echo "[pre-commit] SKIP_MYPY=1, 跳过 mypy 类型检查"
    else
        BACKEND_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/app/*.py' 2>/dev/null || true)
        if [ -n "$BACKEND_STAGED" ]; then
            echo "[pre-commit] 检测到后端 Python 变更，正在执行 mypy ..."
            cd backend
            if python -m mypy 2>&1; then
                echo "[pre-commit] ✅ mypy 通过"
                cd ..
            else
                cd ..
                echo ""
                echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
                echo "!  🚫 mypy 类型检查失败                                       !"
                echo "!  请修复类型错误后重试，或 SKIP_MYPY=1 git commit ...        !"
                echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
                exit 1
            fi
        fi
    fi
fi

# ── Docker 构建冒烟门禁（R6-F16） ────────────────────────────────
# round6 诊断：R6-01 构建回归（mootdx httpx 冲突 + tenacity 漏装）在宿主机单测
# 全绿时镜像无法构建——Docker 构建从未纳入门禁。requirements.txt / Dockerfile
# 变更时必须实际构建 backend 镜像（pip --dry-run 无法捕获 --no-deps 序列问题）。
# 跳过: SKIP_DOCKER_BUILD=1 git commit ...
if [ "${SKIP_DOCKER_BUILD}" = "1" ]; then
    echo "[pre-commit] SKIP_DOCKER_BUILD=1, 跳过 Docker 构建冒烟检查"
else
    DOCKER_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/requirements.txt' 'backend/Dockerfile' 2>/dev/null || true)
    if [ -n "$DOCKER_STAGED" ]; then
        if command -v docker >/dev/null 2>&1; then
            echo "[pre-commit] 检测到 requirements.txt / Dockerfile 变更，正在执行 docker build backend 冒烟 ..."
            # ⚠️ 赋值必须放在 if 条件内：set -e 下命令替换失败会直接退出脚本，
            # 导致 daemon 不可用（非构建回归）无法走 case 分支优雅跳过。
            if SMOKE_OUTPUT=$(docker build -q -t etf_surge-backend-smoke ./backend 2>&1); then
                echo "[pre-commit] ✅ docker build backend 冒烟通过"
            else
                case "$SMOKE_OUTPUT" in
                    *"failed to connect to the docker API"*|*"Cannot connect to the Docker daemon"*|*"is the docker daemon running"*|*"error during connect"*|*"connection refused"*)
                        echo "[pre-commit] ⚠️ Docker daemon 不可用，跳过 Docker 构建冒烟（CI 应覆盖此项）"
                        ;;
                    *)
                        echo ""
                        echo "$SMOKE_OUTPUT" | tail -20
                        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
                        echo "!  🚫 docker build backend 失败 — 构建回归（参见 round6 R6-01）!"
                        echo "!  如需跳过: SKIP_DOCKER_BUILD=1 git commit ...              !"
                        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
                        exit 1
                        ;;
                esac
            fi
        else
            echo "[pre-commit] ⚠️ docker 不可用，跳过 Docker 构建冒烟（CI 应覆盖此项）"
        fi
    fi
fi

# ── 后端测试门禁（收紧版，2026-08-09，round11/precommit-optimization） ──
# 档 0：conftest/fixtures 变更 → 全量（影响所有测试场景）
# 档 1：逻辑变更（backend/app 不限 .py、scripts/*.py、requirements.txt）→ 全量 pytest
# 档 2：仅测试 .py 变更 → 只跑变更的测试文件（秒级，替代 1620/3:39）
if [ "${SKIP_BACKEND_TESTS}" = "1" ]; then
    echo "[pre-commit] SKIP_BACKEND_TESTS=1, 跳过后端测试"
else
    # 档 0：conftest/fixtures 变更 → 全量（影响所有测试场景）
    CONFTEST_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'backend/tests/conftest.py' 'backend/tests/db_fixtures.py' 2>/dev/null || true)
    # 档 1：逻辑变更 → 全量 pytest。
    # ⚠️ backend/app/* 不限 .py：app 下含运行时非 .py（prompts/v1/*.md ×11、factors/factor_definitions.yaml），
    #    改 LLM prompt 模板 / 因子定义也属逻辑变更，必须触发全量。
    LOGIC_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'backend/app/*' 'backend/scripts/*.py' 'backend/requirements.txt' 2>/dev/null || true)
    # 档 2：仅测试 .py 变更 → 只跑变更的测试文件（秒级）
    TEST_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'backend/tests/*.py' 2>/dev/null || true)
    # 其它 backend 变更：根级散件（.env.example/pytest.ini/*.py 骨架）+ tests 下非 .py
    # （fixture 数据/快照）→ 全量保守不短路
    OTHER_BACKEND=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'backend/*' ':!backend/app/*' ':!backend/scripts/*' ':!backend/tests/*.py' 2>/dev/null || true)

    if [ -n "$CONFTEST_STAGED" ] || [ -n "$LOGIC_STAGED" ] || [ -n "$OTHER_BACKEND" ]; then
        echo "[pre-commit] 检测到后端逻辑变更，执行 pytest 全量（xdist 并行）..."
        cd backend
        # F23 (round6 §17.2): 外层 timeout 兜底——pytest 进程级超时（30min），
        # 配合 pytest.ini 全局 --timeout=180（单测试级），任何一层挂起都会
        # 报 FAIL 而非无限挂起（commit 曾卡死 ~1 小时）。
        # 2026-08-09: -n auto 并行（pytest-xdist）全量 220s → 90s；测试间隔离
        # 已验证（临时 DB + autouse 缓存清理 fixture）。xdist 缺失时回退串行。
        XDIST_ARGS=""
        if python -m pytest --version 2>&1 | grep -qi xdist; then
            XDIST_ARGS="-n auto"
        else
            echo "[pre-commit] ⚠️ pytest-xdist 未安装，回退单进程（建议 pip install -r requirements.txt）"
        fi
        if timeout 1800 python -m pytest -x $XDIST_ARGS 2>&1; then
            echo "[pre-commit] ✅ pytest 全量通过"; cd ..
        else
            cd ..; echo "🚫 pytest 失败或超时"; exit 1
        fi
    elif [ -n "$TEST_STAGED" ]; then
        # 纯测试文件 .py 变更（docstring/新增用例）→ 只跑变更的测试文件
        echo "[pre-commit] 检测到仅测试文件变更，执行受影响测试 ..."
        cd backend
        # 只跑变更的测试文件（替换全量；git diff 输出 backend/tests/test_x.py → 相对路径）
        TESTS_TO_RUN=$(printf '%s\n' "$TEST_STAGED" | sed 's#^backend/##' | tr '\n' ' ')
        # ⚠️ 保留基线 -x 快速失败语义
        if timeout 600 python -m pytest -x $TESTS_TO_RUN 2>&1; then
            echo "[pre-commit] ✅ affected tests 通过"; cd ..
        else
            cd ..; echo "🚨 affected tests 失败（见上）"; exit 1
        fi
    fi
fi

# ════ 测试冗余基线门禁（P3-6，2026-08-09）═══════════════════════════════════
# 测试文件数不再反弹：backend/tests/test_*.py ≤ 197（P1-8 合并后基线）。
# 仅当 tests/ 或本脚本有变更时触发；新测试必须并入已有文件。
TEST_BASELINE_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
    -- 'backend/tests/*.py' 'backend/scripts/check_test_baseline.py' 2>/dev/null || true)
if [ -n "$TEST_BASELINE_STAGED" ]; then
    echo "[pre-commit] 检测到测试文件变更，执行 P3-6 测试冗余基线检查 ..."
    cd backend
    if python scripts/check_test_baseline.py 2>&1; then
        echo "[pre-commit] ✅ P3-6 基线检查通过（test_*.py ≤ 197）"; cd ..
    else
        cd ..; echo "🚨 P3-6 基线检查失败（测试文件数反弹）"; exit 1
    fi
fi

# ── 后端启动冒烟测试（P3-3） ──────────────────────────────────
if [ "${SKIP_SMOKE_STARTUP}" = "1" ]; then
    echo "[pre-commit] SKIP_SMOKE_STARTUP=1, 跳过启动冒烟测试"
else
    BACKEND_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/app/*.py' 'backend/scripts/*.py' 'backend/requirements.txt' 2>/dev/null || true)

    if [ -n "$BACKEND_STAGED" ]; then
        echo "[pre-commit] 检测到后端文件变更，正在执行 smoke_startup.py（快速模式）..."
        cd backend
        if SMOKE_FAST=1 python scripts/smoke_startup.py 2>&1; then
            echo "[pre-commit] ✅ smoke_startup 通过"
            cd ..
        else
            cd ..
            echo ""
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            echo "!  🚫 后端启动冒烟测试失败                                      !"
            echo "!  backend/app/ 的变更导致 uvicorn 启动异常。                   !"
            echo "!  请检查后端是否能在本地正常启动。                              !"
            echo "!  如需跳过: SKIP_SMOKE_STARTUP=1 git commit ...               !"
            echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            exit 1
        fi
    fi
fi

exit 0
