# ETF Surge 前端环境变量示例
# 复制为 .env.local 或 .env 使用 (gitignored)

# Vite 开发服务器代理目标 (本地开发默认指向 localhost:8000)
# Docker dev 模式下 docker-compose.yml 会注入 VITE_PROXY_TARGET=http://backend-dev:8000
VITE_PROXY_TARGET=http://localhost:8000

# WebSocket 代理目标
VITE_WS_TARGET=ws://localhost:8000

# API 基础路径 (必须与后端 apiPrefix 一致)
VITE_API_PREFIX=/api/v1