DATABASE_URL=sqlite+aiosqlite:///./data/portfolio.db
REDIS_URL=redis://localhost:6379/0
# CORS origins：逗号分隔（* 表示全开（仅开发用）；生产请显式列出域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── LLM Provider 配置（P3-3: 与 .env 键集一致）──
# 主 provider（当前为 opencode_zen；历史值为 deepseek）
LLM_PROVIDER=opencode_zen
LLM_MODEL=deepseek-v4-flash-free
# OpenCode Zen（主 provider）
OPENCODE_ZEN_API_KEY=your_opencode_zen_key_here
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
OPENCODE_ZEN_API_URL=https://opencode.ai/zen/v1/chat/completions
# DeepSeek（备 provider）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 主/备 provider 显式声明（覆盖 LLM_PROVIDER 派生逻辑时使用）
LLM_PRIMARY_PROVIDER=opencode_zen
LLM_FALLBACK_PROVIDER=deepseek
# 超时（秒）
LLM_PRIMARY_TIMEOUT=240
LLM_FALLBACK_TIMEOUT=240

# ── 外部数据源（可选，未配置则对应源自动跳过）──
# Tushare（A 股）
TUSHARE_TOKEN=your_tushare_token_here
# FRED（宏观）
FRED_API_KEY=your_fred_api_key_here
# Alpha Vantage（美股）— https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=your_key_here
# Finnhub（美股）— https://finnhub.io/register (free tier: 60 calls/min)
# FINNHUB_API_KEY=your_key_here
# TwelveData（全球指数/外汇）
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
# yfinance optional proxy (e.g. http://127.0.0.1:7890), required in mainland China
# YFINANCE_PROXY=http://127.0.0.1:7890

# ── 日志 ──
LOG_LEVEL=INFO
LOG_FILE=
